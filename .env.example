# GNI Phase 0 — copy to .env and fill values. Never commit real secrets.

# Application
GNI_ENV=dev
GNI_LOG_LEVEL=INFO
GNI_TIMEZONE=UTC

# Database — default for Colima + docker-compose:
GNI_DATABASE_URL=postgresql+psycopg://gni:gni@localhost:5432/gni
# Fallback without Colima/Docker:
# GNI_DATABASE_URL=sqlite+pysqlite:///./data/gni_p1a.db

# HTTP / ingestion
GNI_HTTP_USER_AGENT=GNI-ResearchBot/0.1 (+internal-research)

# DeepSeek LLM — put the real key in local `.env` (never commit).
# Empty key → analyze falls back to heuristic-rules (no network LLM).
# Create key: https://platform.deepseek.com/
GNI_LLM_PROVIDER=deepseek
GNI_LLM_API_KEY=
GNI_LLM_BASE_URL=https://api.deepseek.com
GNI_LLM_MODEL=deepseek-chat

# Cost controls (placeholders for Phase 1)
GNI_DAILY_LLM_BUDGET_USD=10
GNI_DAILY_ARTICLE_LIMIT=500
GNI_PER_ARTICLE_TOKEN_LIMIT=8000

# Report
GNI_REPORT_TIMEZONE=Asia/Shanghai

# Meilisearch (optional; Search API falls back to Postgres ilike when down)
GNI_MEILI_URL=http://127.0.0.1:7700
GNI_MEILI_KEY=gni_dev_meili_key
