%% GNI ERD — data layers (logical)
%% See docs/DATA_LAYERS.md

erDiagram
    countries ||--o{ organizations : has
    organizations ||--o{ sources : owns
    sources ||--o{ source_reviews : reviewed
    sources ||--o{ source_attribute_history : history
    sources ||--o| source_health : health
    sources ||--o{ articles : publishes
    sources ||--o{ ingestion_jobs : runs
    sources ||--o{ collection_tasks : tasked
    sources ||--o{ raw_documents : captures
    sources ||--o{ discovered_articles : discovers

    collection_tasks ||--o{ raw_documents : includes
    collection_tasks ||--o{ discovered_articles : finds

    raw_documents ||--o| discovered_articles : materializes
    discovered_articles ||--o| articles : promotes

    articles ||--o{ article_versions : versions
    articles ||--o{ article_screenings : screened
    articles ||--o{ article_china_spans : spans
    articles ||--o{ article_relevance_assessments : relevance
    articles ||--o{ article_analyses : analyzed
    articles ||--o{ event_articles : linked

    analysis_runs ||--o{ article_analyses : batch
    events ||--o{ event_articles : contains
    events ||--o{ event_locations : located
    events ||--o{ event_participants : involves
    events ||--o{ narrative_clusters : narratives
    narrative_clusters ||--o{ event_narrative_evidence : evidence

    collection_tasks {
        uuid id PK
        string task_type
        string source_id FK
        string status
        jsonb stats
    }

    raw_documents {
        uuid id PK
        string source_id FK
        uuid collection_task_id FK
        uuid discovered_article_id FK
        string url
        string content_type
        text payload_text
        string payload_hash
        string object_key
        timestamptz fetched_at
    }

    discovered_articles {
        uuid id PK
        string source_id FK
        string url
        uuid raw_document_id FK
        uuid article_id FK
        string status
        timestamptz discovered_at
    }

    articles {
        uuid id PK
        string source_id FK
        string url
        string pipeline_state
        string processing_status
        string analysis_status
        string quality_status
        uuid latest_raw_document_id
        uuid latest_article_version_id
        string content_hash
        timestamptz published_at
    }

    article_versions {
        uuid id PK
        uuid article_id FK
        int version_no
        text content_clean
        string content_hash
    }

    article_analyses {
        uuid id PK
        uuid article_id FK
        uuid analysis_run_id FK
        jsonb structured_result
        string prompt_version
        string model_name
    }

    events {
        uuid id PK
        string status
        string title
    }
