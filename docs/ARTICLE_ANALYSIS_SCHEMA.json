{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gni.local/schemas/article_analysis_v0.2.json",
  "title": "GNI Article Analysis Result",
  "description": "Document-level schema draft aligned to Blueprint V4. Does not imply a DB migration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "taxonomy_version",
    "language",
    "china_relevance",
    "topics",
    "sentiment",
    "stances",
    "framing",
    "entities",
    "evidence",
    "field_status",
    "confidence"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "article_analysis_v0.2" },
    "taxonomy_version": { "type": "string", "minLength": 1 },
    "relevance_weight_version": { "type": "string" },
    "language": { "type": "string", "minLength": 2 },
    "china_relevance": {
      "type": "object",
      "required": ["level", "weight", "status"],
      "properties": {
        "is_relevant": { "type": ["boolean", "null"] },
        "level": {
          "type": "string",
          "enum": [
            "core",
            "substantial",
            "secondary",
            "incidental",
            "none",
            "uncertain"
          ],
          "description": "Addendum A1 levels; legacy major/moderate/minor/not_relevant map to substantial/secondary/incidental/none"
        },
        "weight": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "estimated_share": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "title_mentions_china": { "type": ["boolean", "null"] },
        "lead_mentions_china": { "type": ["boolean", "null"] },
        "china_is_primary_subject": { "type": ["boolean", "null"] },
        "features": {
          "type": "object",
          "additionalProperties": true
        },
        "rationale": { "type": "string" },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "status": {
          "type": "string",
          "enum": [
            "known",
            "unknown",
            "ambiguous",
            "insufficient_evidence",
            "not_applicable",
            "needs_review"
          ]
        }
      }
    },
    "topics": {
      "type": "object",
      "required": ["primary", "secondary"],
      "properties": {
        "primary": { "type": ["string", "null"] },
        "secondary": {
          "type": "array",
          "items": { "type": "string" }
        },
        "prominence": {
          "type": "string",
          "enum": ["core", "secondary_mention", "unknown"]
        }
      }
    },
    "sentiment": {
      "type": "object",
      "required": ["label", "status"],
      "properties": {
        "label": {
          "type": ["string", "null"],
          "enum": ["positive", "negative", "neutral", "mixed", null]
        },
        "score": {
          "type": ["number", "null"],
          "minimum": -1,
          "maximum": 1,
          "description": "Continuous sentiment s_i in [-1,1]; mapping rules TBD"
        },
        "emotions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "fear",
              "concern",
              "anger",
              "optimism",
              "praise",
              "criticism",
              "uncertainty"
            ]
          }
        },
        "intensity": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "basis_segment_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status": {
          "type": "string",
          "enum": [
            "known",
            "unknown",
            "ambiguous",
            "insufficient_evidence",
            "not_applicable"
          ]
        }
      }
    },
    "stances": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target_id", "stance", "status"],
        "properties": {
          "target_id": { "type": "string" },
          "target_surface_form": { "type": "string" },
          "stance": {
            "type": ["string", "null"],
            "enum": [
              "supportive",
              "opposing",
              "critical",
              "cautious",
              "neutral",
              "no_explicit_stance",
              "mixed",
              "ambiguous",
              null
            ]
          },
          "strength": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "status": {
            "type": "string",
            "enum": [
              "known",
              "unknown",
              "ambiguous",
              "insufficient_evidence",
              "not_applicable"
            ]
          }
        }
      }
    },
    "framing": {
      "type": "object",
      "required": ["primary", "secondary", "status"],
      "properties": {
        "primary": { "type": ["string", "null"] },
        "secondary": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status": {
          "type": "string",
          "enum": [
            "known",
            "unknown",
            "ambiguous",
            "insufficient_evidence",
            "not_applicable"
          ]
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "type"],
        "properties": {
          "text": { "type": "string" },
          "type": {
            "type": "string",
            "enum": [
              "person",
              "organization",
              "country",
              "location",
              "policy",
              "product",
              "company",
              "other"
            ]
          },
          "normalized_id": { "type": ["string", "null"] },
          "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_text": { "type": "string" },
          "speaker": { "type": "string" },
          "attribution": {
            "type": "string",
            "enum": ["media", "quoted", "unclear"]
          },
          "target_id": { "type": ["string", "null"] },
          "evidence_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field_path", "quote", "evidence_type"],
        "properties": {
          "field_path": { "type": "string" },
          "quote": { "type": "string", "minLength": 1 },
          "start_offset": { "type": ["integer", "null"], "minimum": 0 },
          "end_offset": { "type": ["integer", "null"], "minimum": 0 },
          "paragraph_index": { "type": ["integer", "null"], "minimum": 0 },
          "evidence_type": {
            "type": "string",
            "enum": [
              "sentiment",
              "stance",
              "frame",
              "topic",
              "entity",
              "relevance",
              "claim",
              "other"
            ]
          },
          "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
        }
      }
    },
    "summary": { "type": "string" },
    "analysis_status": {
      "type": "string",
      "enum": [
        "completed",
        "needs_review",
        "insufficient_evidence",
        "failed"
      ]
    },
    "field_status": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "known",
          "unknown",
          "ambiguous",
          "insufficient_evidence",
          "not_applicable"
        ]
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "notes": { "type": "string" }
  }
}
